# HollowTone Server configuration example.
# Copy to `.env` (docker-compose reads it) or export these variables directly.

# Listen address.
HT_ADDR=:8080

# Root directory for the SQLite DB, media objects and cover art.
HT_DATA_DIR=/data

# Optional explicit paths (default to subdirectories of HT_DATA_DIR).
# HT_DB_PATH=/data/hollowtone_server.sqlite
# HT_MEDIA_DIR=/data/media
# HT_ART_DIR=/data/art

# Fixed JWT signing secret. Provide a long random string in production.
# If empty, the server generates one and stores it at $HT_DATA_DIR/.jwt_secret.
# HT_JWT_SECRET=

# Access token lifetime (Go duration syntax).
HT_TOKEN_TTL=720h

# Whether public registration is enabled. The very first account can always be
# created to bootstrap the server.
HT_ALLOW_REGISTER=true

# Maximum size of a single whole-file upload (bytes).
HT_MAX_UPLOAD_BYTES=2147483648

# Advertised chunk size for resumable uploads (bytes).
HT_CHUNK_SIZE=8388608
