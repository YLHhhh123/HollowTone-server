# Normalise line endings so a Windows checkout cannot break the POSIX scripts:
# a CRLF shebang makes `#!/usr/bin/env sh` fail on Linux/macOS with
# ": not found" / "bad interpreter".
* text=auto

*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.go    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf

# Prebuilt artifacts must never be line-ending translated.
*.exe    binary
*.sqlite binary
